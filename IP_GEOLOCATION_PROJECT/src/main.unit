#include <gtest/gtest.h>
#include <gmock/gmock.h>
#include <sstream>
#include <streambuf>
#include <string>
#include <vector>
#include <memory>
#include <thread>
#include <chrono>

// Макросы для перехвата вывода
#define CAPTURE_STDOUT(code) \
    std::stringstream capture_##__LINE__; \
    auto old_##__LINE__ = std::cout.rdbuf(capture_##__LINE__.rdbuf()); \
    code; \
    std::cout.rdbuf(old_##__LINE__); \
    std::string output = capture_##__LINE__.str();

#define CAPTURE_STDERR(code) \
    std::stringstream capture_err_##__LINE__; \
    auto old_err_##__LINE__ = std::cerr.rdbuf(capture_err_##__LINE__.rdbuf()); \
    code; \
    std::cerr.rdbuf(old_err_##__LINE__); \
    std::string error_output = capture_err_##__LINE__.str();

// Заглушки для внешних зависимостей
namespace ip_geolocation {
    class MockGeoLocationService : public GeoLocationService {
    public:
        MOCK_METHOD(void, setApiKey, (const std::string&), (override));
        MOCK_METHOD(void, setDatabasePath, (const std::string&), (override));
        MOCK_METHOD(GeoLocation, getLocation, (const std::string&), (override));
        MOCK_METHOD(void, getLocationAsync, (const std::string&, std::function<void(const GeoLocation&)>), (override));
        MOCK_METHOD(bool, isAvailable, (), (override));
        MOCK_METHOD(void, clearCache, (), (override));
    };
}

// Тестовая фикстура для изоляции тестов
class CLITest : public ::testing::Test {
protected:
    void SetUp() override {
        // Сохраняем оригинальные буферы
        old_cout_buf = std::cout.rdbuf();
        old_cerr_buf = std::cerr.rdbuf();
        
        // Перенаправляем вывод в строковые потоки
        std::cout.rdbuf(cout_buffer.rdbuf());
        std::cerr.rdbuf(cerr_buffer.rdbuf());
    }
    
    void TearDown() override {
        // Восстанавливаем оригинальные буферы
        std::cout.rdbuf(old_cout_buf);
        std::cerr.rdbuf(old_cerr_buf);
    }
    
    // Вспомогательная функция для запуска main с аргументами
    int runMain(const std::vector<std::string>& args) {
        std::vector<char*> argv;
        for (const auto& arg : args) {
            argv.push_back(const_cast<char*>(arg.c_str()));
        }
        
        // Очищаем буферы перед запуском
        cout_buffer.str("");
        cout_buffer.clear();
        cerr_buffer.str("");
        cerr_buffer.clear();
        
        // Вызываем main
        return main(static_cast<int>(argv.size()), argv.data());
    }
    
    std::string getStdout() const { return cout_buffer.str(); }
    std::string getStderr() const { return cerr_buffer.str(); }
    
private:
    std::stringstream cout_buffer;
    std::stringstream cerr_buffer;
    std::streambuf* old_cout_buf = nullptr;
    std::streambuf* old_cerr_buf = nullptr;
};

// ============================================================
// Тесты для вывода справки
// ============================================================

TEST_F(CLITest, NoArguments_ShowsUsage) {
    int result = runMain({"./geolocation_tool"});
    
    EXPECT_EQ(result, 1);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("IP Geolocation Tool"));
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Usage:"));
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("<IP_ADDRESS>"));
}

TEST_F(CLITest, HelpFlag_ShowsUsageAndExitsSuccessfully) {
    int result = runMain({"./geolocation_tool", "--help"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("IP Geolocation Tool"));
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Usage:"));
}

TEST_F(CLITest, HelpShortFlag_ShowsUsageAndExitsSuccessfully) {
    int result = runMain({"./geolocation_tool", "-h"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("IP Geolocation Tool"));
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Usage:"));
}

// ============================================================
// Тесты для синхронного режима
// ============================================================

TEST_F(CLITest, ValidIPv4_DisplaysLocationInfo) {
    // Этот тест требует реального сервиса, может быть медленным
    int result = runMain({"./geolocation_tool", "8.8.8.8"});
    
    EXPECT_EQ(result, 0);
    std::string output = getStdout();
    EXPECT_THAT(output, ::testing::HasSubstr("Запрашиваем геолокацию"));
    EXPECT_THAT(output, ::testing::HasSubstr("8.8.8.8"));
    EXPECT_THAT(output, ::testing::HasSubstr("success"));
}

TEST_F(CLITest, ValidIPv6_DisplaysLocationInfo) {
    int result = runMain({"./geolocation_tool", "2001:4860:4860::8888"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("success"));
}

TEST_F(CLITest, InvalidIP_ShowsErrorMessage) {
    int result = runMain({"./geolocation_tool", "invalid_ip"});
    
    EXPECT_EQ(result, 0); // Программа не падает, просто выводит ошибку
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("error"));
    EXPECT_FALSE(getStdout().empty());
}

TEST_F(CLITest, MeCommand_ShowsCurrentIP) {
    int result = runMain({"./geolocation_tool", "me"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Запрашиваем геолокацию"));
}

TEST_F(CLITest, LocalhostIP_HandlesGracefully) {
    int result = runMain({"./geolocation_tool", "127.0.0.1"});
    
    EXPECT_EQ(result, 0);
    // Должен завершиться без падения
}

TEST_F(CLITest, EmptyIP_DisplaysError) {
    int result = runMain({"./geolocation_tool", ""});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("error"));
}

// ============================================================
// Тесты для асинхронного режима
// ============================================================

TEST_F(CLITest, AsyncMode_WithValidIP_DisplaysResult) {
    int result = runMain({"./geolocation_tool", "--async", "8.8.8.8"});
    
    EXPECT_EQ(result, 0);
    std::string output = getStdout();
    EXPECT_THAT(output, ::testing::HasSubstr("асинхронно"));
    EXPECT_THAT(output, ::testing::HasSubstr("Ожидание результатов"));
    EXPECT_THAT(output, ::testing::HasSubstr("Результат"));
}

TEST_F(CLITest, AsyncMode_WithInvalidIP_ShowsError) {
    int result = runMain({"./geolocation_tool", "--async", "invalid_ip"});
    
    EXPECT_EQ(result, 0);
    std::string output = getStdout();
    EXPECT_THAT(output, ::testing::HasSubstr("асинхронно"));
    EXPECT_THAT(output, ::testing::HasSubstr("error"));
}

TEST_F(CLITest, AsyncMode_WithoutIP_ShowsUsage) {
    int result = runMain({"./geolocation_tool", "--async"});
    
    EXPECT_EQ(result, 1);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Usage:"));
}

TEST_F(CLITest, AsyncMode_WithMeCommand_ShowsCurrentIP) {
    int result = runMain({"./geolocation_tool", "--async", "me"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("асинхронно"));
}

// ============================================================
// Тесты на обработку ошибок
// ============================================================

TEST_F(CLITest, ExceptionHandling_ShowsErrorMessage) {
    // Симулируем ситуацию, когда сервис недоступен
    // В реальном тесте это может быть timeout или network error
    int result = runMain({"./geolocation_tool", "8.8.8.8"});
    
    // Если сервис недоступен, должно быть сообщение об ошибке
    std::string output = getStdout();
    if (result != 0) {
        EXPECT_FALSE(getStderr().empty());
    }
}

TEST_F(CLITest, TooManyArguments_IgnoresExtra) {
    // Программа должна игнорировать лишние аргументы
    int result = runMain({"./geolocation_tool", "8.8.8.8", "extra_arg"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("8.8.8.8"));
}

// ============================================================
// Тесты на вывод формата
// ============================================================

TEST_F(CLITest, OutputContainsRequiredFields) {
    int result = runMain({"./geolocation_tool", "8.8.8.8"});
    
    if (result == 0) {
        std::string output = getStdout();
        // Проверяем наличие ключевых полей
        EXPECT_THAT(output, ::testing::AnyOf(
            ::testing::HasSubstr("country"),
            ::testing::HasSubstr("city"),
            ::testing::HasSubstr("ip")
        ));
    }
}

TEST_F(CLITest, OutputIsNotEmpty) {
    int result = runMain({"./geolocation_tool", "8.8.8.8"});
    
    EXPECT_EQ(result, 0);
    EXPECT_FALSE(getStdout().empty());
}

// ============================================================
// Тесты производительности
// ============================================================

TEST_F(CLITest, SyncMode_PerformanceUnder1Second) {
    auto start = std::chrono::high_resolution_clock::now();
    
    int result = runMain({"./geolocation_tool", "8.8.8.8"});
    
    auto end = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    
    EXPECT_EQ(result, 0);
    EXPECT_LT(duration.count(), 1000) << "Sync request took " << duration.count() << "ms";
}

TEST_F(CLITest, AsyncMode_ReturnsQuickly) {
    auto start = std::chrono::high_resolution_clock::now();
    
    int result = runMain({"./geolocation_tool", "--async", "8.8.8.8"});
    
    auto end = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    
    EXPECT_EQ(result, 0);
    // Асинхронный режим должен вернуться быстро (не дожидаясь реального ответа)
    EXPECT_LT(duration.count(), 100) << "Async call took " << duration.count() << "ms";
}

// ============================================================
// Интеграционные тесты с разными типами IP
// ============================================================

class CLIParameterizedTest : public CLITest,
                             public ::testing::WithParamInterface<std::tuple<std::string, bool>> {};

TEST_P(CLIParameterizedTest, VariousIPs_DoNotCrash) {
    auto [ip, should_succeed] = GetParam();
    
    int result = runMain({"./geolocation_tool", ip});
    
    EXPECT_EQ(result, 0);
    if (should_succeed) {
        EXPECT_THAT(getStdout(), ::testing::HasSubstr(ip));
    }
}

INSTANTIATE_TEST_SUITE_P(
    IPVariants,
    CLIParameterizedTest,
    ::testing::Values(
        std::make_tuple("8.8.8.8", true),
        std::make_tuple("1.1.1.1", true),
        std::make_tuple("4.4.4.4", true),
        std::make_tuple("me", true),
        std::make_tuple("127.0.0.1", true),
        std::make_tuple("192.168.1.1", true),
        std::make_tuple("0.0.0.0", true),
        std::make_tuple("255.255.255.255", true),
        std::make_tuple("invalid_ip", false),
        std::make_tuple("999.999.999.999", false),
        std::make_tuple("256.1.1.1", false)
    )
);

// ============================================================
// Тесты на обработку сигналов
// ============================================================

TEST_F(CLITest, LongRunningRequest_CanBeInterrupted) {
    // Тестируем, что программа корректно обрабатывает таймауты
    // В асинхронном режиме есть sleep, проверяем что он не блокирует
    int result = runMain({"./geolocation_tool", "--async", "8.8.8.8"});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("Ожидание результатов"));
}

// ============================================================
// Тесты на потокобезопасность вывода
// ============================================================

TEST_F(CLITest, AsyncMode_OutputIsCoherent) {
    std::string output;
    
    // Запускаем несколько раз
    for (int i = 0; i < 5; ++i) {
        runMain({"./geolocation_tool", "--async", "8.8.8.8"});
        output = getStdout();
        
        // Проверяем, что вывод не поврежден
        EXPECT_THAT(output, ::testing::HasSubstr("Запрашиваем геолокацию"));
        EXPECT_THAT(output, ::testing::HasSubstr("Ожидание результатов"));
        EXPECT_THAT(output, ::testing::HasSubstr("Результат"));
        
        // Очищаем перед следующим запуском
        SetUp();
    }
}

// ============================================================
// Тесты на корректность аргументов командной строки
// ============================================================

TEST_F(CLITest, WhitespaceInIP_IsTreatedAsArgument) {
    // IP с пробелами не должен обрабатываться корректно
    int result = runMain({"./geolocation_tool", "8.8.8. 8"});
    
    EXPECT_EQ(result, 0);
    // Должен быть error, т.к. IP невалидный
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("error"));
}

TEST_F(CLITest, VeryLongIP_HandlesGracefully) {
    std::string long_ip(1000, '1');
    int result = runMain({"./geolocation_tool", long_ip});
    
    EXPECT_EQ(result, 0);
    EXPECT_THAT(getStdout(), ::testing::HasSubstr("error"));
}

// ============================================================
// Тесты на кодировку вывода
// ============================================================

TEST_F(CLITest, OutputEncoding_IsUTF8) {
    int result = runMain({"./geolocation_tool", "me"});
    
    EXPECT_EQ(result, 0);
    // Проверяем, что русский текст выводится корректно
    std::string output = getStdout();
    EXPECT_THAT(output, ::testing::HasSubstr("Запрашиваем"));
    EXPECT_THAT(output, ::testing::HasSubstr("геолокацию"));
}

// ============================================================
// Тесты для сравнения синхронного и асинхронного режимов
// ============================================================

TEST_F(CLITest, SyncVsAsync_BothReturnSameData) {
    // Синхронный режим
    runMain({"./geolocation_tool", "8.8.8.8"});
    std::string sync_output = getStdout();
    
    SetUp(); // Очищаем буфер
    
    // Асинхронный режим
    runMain({"./geolocation_tool", "--async", "8.8.8.8"});
    std::string async_output = getStdout();
    
    // Оба должны вывести данные об IP 8.8.8.8
    EXPECT_THAT(sync_output, ::testing::HasSubstr("8.8.8.8"));
    EXPECT_THAT(async_output, ::testing::HasSubstr("8.8.8.8"));
}

