// ============================================================
// Benchmark тесты
// ============================================================

TEST_F(CLITest, DISABLED_Benchmark_MultipleRequests) {
    const int iterations = 10;
    std::vector<long long> durations;
    
    for (int i = 0; i < iterations; ++i) {
        auto start = std::chrono::high_resolution_clock::now();
        runMain({"./geolocation_tool", "8.8.8.8"});
        auto end = std::chrono::high_resolution_clock::now();
        
        durations.push_back(std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count());
        SetUp(); // Очищаем для следующей итерации
    }
    
    // Вычисляем среднее время
    long long sum = 0;
    for (auto d : durations) sum += d;
    long long avg = sum / iterations;
    
    std::cout << "Average response time over " << iterations << " requests: " << avg << "ms" << std::endl;
    EXPECT_LT(avg, 500) << "Average time too high: " << avg << "ms";
}

// ============================================================
// Main function
// ============================================================

int main(int argc, char** argv) {
    ::testing::InitGoogleTest(&argc, argv);
    ::testing::InitGoogleMock(&argc, argv);
    
    // Для тестов, требующих реальных сетевых запросов, можно добавить флаг
    ::testing::FLAGS_gtest_death_test_style = "threadsafe";
    
    return RUN_ALL_TESTS();
}
