class GeoLocationServiceTest : public ::testing::Test {
protected:
    void SetUp() override {
        service = std::make_unique<GeoLocationService>();
    }
    
    void TearDown() override {
        service.reset();
    }
    
    std::unique_ptr<GeoLocationService> service;
};

TEST_F(GeoLocationServiceTest, Constructor_CreatesInstance) {
    EXPECT_NE(service, nullptr);
    EXPECT_NO_THROW(GeoLocationService());
}

TEST_F(GeoLocationServiceTest, SetApiKey_ValidKey_NoThrow) {
    EXPECT_NO_THROW(service->setApiKey("test_key_12345"));
    EXPECT_NO_THROW(service->setApiKey(""));
}

TEST_F(GeoLocationServiceTest, SetDatabasePath_ValidPath_NoThrow) {
    EXPECT_NO_THROW(service->setDatabasePath("./GeoLite2-City.mmdb"));
    EXPECT_NO_THROW(service->setDatabasePath(""));
    EXPECT_NO_THROW(service->setDatabasePath("/tmp/nonexistent.mmdb"));
}

TEST_F(GeoLocationServiceTest, SetApiKey_AfterSetDatabasePath_Works) {
    EXPECT_NO_THROW(service->setDatabasePath("./data.mmdb"));
    EXPECT_NO_THROW(service->setApiKey("new_key"));
}

TEST_F(GeoLocationServiceTest, GetLocation_ValidIPv4_ReturnsValidData) {
    GeoLocation result = service->getLocation("8.8.8.8");
    
    EXPECT_TRUE(result.success);
    EXPECT_EQ(result.ip, "8.8.8.8");
    EXPECT_FALSE(result.country.empty());
    EXPECT_FALSE(result.country_code.empty());
    EXPECT_GE(result.latitude, -90.0);
    EXPECT_LE(result.latitude, 90.0);
    EXPECT_GE(result.longitude, -180.0);
    EXPECT_LE(result.longitude, 180.0);
}

TEST_F(GeoLocationServiceTest, GetLocation_ValidIPv6_ReturnsValidData) {
    GeoLocation result = service->getLocation("2001:4860:4860::8888");
    
    EXPECT_TRUE(result.success);
    EXPECT_FALSE(result.country.empty());
}

TEST_F(GeoLocationServiceTest, GetLocation_InvalidIP_ReturnsError) {
    std::vector<std::string> invalid_ips = {
        "invalid",
        "999.999.999.999",
        "256.1.1.1",
        "192.168.1",
        "test.invalid"
    };
    
    for (const auto& ip : invalid_ips) {
        GeoLocation result = service->getLocation(ip);
        EXPECT_FALSE(result.success) << "Expected failure for IP: " << ip;
        EXPECT_FALSE(result.error_message.empty()) << "Expected error message for IP: " << ip;
    }
}

TEST_F(GeoLocationServiceTest, GetLocation_EmptyIP_ReturnsError) {
    GeoLocation result = service->getLocation("");
    
    EXPECT_FALSE(result.success);
    EXPECT_FALSE(result.error_message.empty());
    EXPECT_THAT(result.error_message, AnyOf(HasSubstr("empty"), HasSubstr("invalid")));
}

TEST_F(GeoLocationServiceTest, GetLocation_Localhost_HandlesCorrectly) {
    GeoLocation result = service->getLocation("127.0.0.1");
    
    // Localhost может быть обработан особым образом
    // Проверяем, что функция не падает
    EXPECT_NO_THROW(service->getLocation("127.0.0.1"));
}

TEST_F(GeoLocationServiceTest, GetLocation_PrivateIP_MayFailOrSucceed) {
    std::vector<std::string> private_ips = {
        "10.0.0.1",
        "172.16.0.1",
        "192.168.1.1"
    };
    
    for (const auto& ip : private_ips) {
        EXPECT_NO_THROW(service->getLocation(ip));
    }
}

TEST_F(GeoLocationServiceTest, GetLocation_SameIP_ReturnsConsistentResults) {
    GeoLocation first = service->getLocation("8.8.8.8");
    GeoLocation second = service->getLocation("8.8.8.8");
    
    EXPECT_EQ(first.success, second.success);
    if (first.success && second.success) {
        EXPECT_EQ(first.country, second.country);
        EXPECT_EQ(first.city, second.city);
        EXPECT_DOUBLE_EQ(first.latitude, second.latitude);
        EXPECT_DOUBLE_EQ(first.longitude, second.longitude);
        EXPECT_EQ(first.isp, second.isp);
    }
}

TEST_F(GeoLocationServiceTest, GetLocation_DifferentIPs_MayReturnDifferentData) {
    GeoLocation google = service->getLocation("8.8.8.8");
    GeoLocation cloudflare = service->getLocation("1.1.1.1");
    
    if (google.success && cloudflare.success) {
        // IPs должны быть разными
        EXPECT_NE(google.ip, cloudflare.ip);
        
        // Могут быть в разных странах или городах
        // Но это не гарантировано
    }
}

TEST_F(GeoLocationServiceTest, GetLocation_PublicIP_ReturnsGeographicData) {
    GeoLocation result = service->getLocation("8.8.8.8");
    
    if (result.success) {
        EXPECT_FALSE(result.country.empty());
        EXPECT_FALSE(result.city.empty() || result.region.empty()); // Хотя бы одно не пустое
        EXPECT_NE(result.latitude, 0.0);
        EXPECT_NE(result.longitude, 0.0);
    }
}

