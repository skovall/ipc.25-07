class GeoLocationTest : public ::testing::Test {
protected:
    void SetUp() override {
        location.ip = "8.8.8.8";
        location.country = "United States";
        location.country_code = "US";
        location.region = "California";
        location.city = "Mountain View";
        location.postal_code = "94043";
        location.latitude = 37.4223;
        location.longitude = -122.0841;
        location.timezone = "America/Los_Angeles";
        location.isp = "Google LLC";
        location.organization = "Google";
        location.success = true;
    }
    
    GeoLocation location;
};

TEST_F(GeoLocationTest, ToString_ValidLocation_ReturnsFormattedString) {
    std::string result = location.toString();
    
    EXPECT_THAT(result, HasSubstr("8.8.8.8"));
    EXPECT_THAT(result, HasSubstr("United States"));
    EXPECT_THAT(result, HasSubstr("Mountain View"));
    EXPECT_THAT(result, HasSubstr("37.4223"));
    EXPECT_THAT(result, HasSubstr("-122.0841"));
}

TEST_F(GeoLocationTest, ToString_FailedLocation_ShowsError) {
    location.success = false;
    location.error_message = "Invalid IP address: 999.999.999.999";
    
    std::string result = location.toString();
    
    EXPECT_THAT(result, HasSubstr("Error"));
    EXPECT_THAT(result, HasSubstr("Invalid IP address"));
    EXPECT_THAT(result, HasSubstr("999.999.999.999"));
}

TEST_F(GeoLocationTest, ToString_EmptyLocation_HandlesEmptyFields) {
    GeoLocation empty;
    empty.success = false;
    empty.error_message = "Unknown error";
    
    std::string result = empty.toString();
    EXPECT_FALSE(result.empty());
    EXPECT_THAT(result, HasSubstr("Unknown error"));
}

TEST_F(GeoLocationTest, DefaultValues_InitializedCorrectly) {
    GeoLocation default_loc;
    
    EXPECT_TRUE(default_loc.ip.empty());
    EXPECT_TRUE(default_loc.country.empty());
    EXPECT_TRUE(default_loc.country_code.empty());
    EXPECT_TRUE(default_loc.region.empty());
    EXPECT_TRUE(default_loc.city.empty());
    EXPECT_TRUE(default_loc.postal_code.empty());
    EXPECT_DOUBLE_EQ(default_loc.latitude, 0.0);
    EXPECT_DOUBLE_EQ(default_loc.longitude, 0.0);
    EXPECT_TRUE(default_loc.timezone.empty());
    EXPECT_TRUE(default_loc.isp.empty());
    EXPECT_TRUE(default_loc.organization.empty());
    EXPECT_TRUE(default_loc.error_message.empty());
    EXPECT_FALSE(default_loc.success);
}

TEST_F(GeoLocationTest, CopyAssignment_CopiesCorrectly) {
    GeoLocation copy;
    copy = location;
    
    EXPECT_EQ(copy.ip, location.ip);
    EXPECT_EQ(copy.country, location.country);
    EXPECT_EQ(copy.city, location.city);
    EXPECT_DOUBLE_EQ(copy.latitude, location.latitude);
    EXPECT_DOUBLE_EQ(copy.longitude, location.longitude);
    EXPECT_EQ(copy.success, location.success);
}

TEST_F(GeoLocationTest, MoveConstructor_MovesCorrectly) {
    GeoLocation original = location;
    GeoLocation moved(std::move(original));
    
    EXPECT_EQ(moved.ip, location.ip);
    EXPECT_TRUE(original.ip.empty()); // moved-from state
}

