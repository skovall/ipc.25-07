TEST_F(GeoLocationServiceTest, GetLocation_Performance_Under100ms) {
    auto start = std::chrono::high_resolution_clock::now();
    GeoLocation result = service->getLocation("8.8.8.8");
    auto end = std::chrono::high_resolution_clock::now();
    
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    
    EXPECT_TRUE(result.success);
    EXPECT_LT(duration.count(), 100) << "getLocation took " << duration.count() << "ms";
}

TEST_F(GeoLocationServiceTest, GetLocation_Cached_PerformanceUnder10ms) {
    // Первый вызов для заполнения кэша
    service->getLocation("8.8.8.8");
    
    auto start = std::chrono::high_resolution_clock::now();
    service->getLocation("8.8.8.8");
    auto end = std::chrono::high_resolution_clock::now();
    
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    EXPECT_LT(duration.count(), 10) << "Cached lookup took " << duration.count() << "ms";
}

// ============================================================
// Тесты на устойчивость к ошибкам
// ============================================================

TEST_F(GeoLocationServiceTest, ConcurrentAccess_IsThreadSafe) {
    const int num_calls = 100;
    std::vector<std::thread> threads;
    std::atomic<int> successes{0};
    
    for (int i = 0; i < num_calls; ++i) {
        threads.emplace_back([this, &successes]() {
            auto result = service->getLocation("8.8.8.8");
            if (result.success) successes++;
        });
    }
    
    for (auto& thread : threads) {
        thread.join();
    }
    
    EXPECT_GT(successes, 0);
}

TEST_F(GeoLocationServiceTest, LongStringIP_HandlesGracefully) {
    std::string long_ip(10000, 'a');
    GeoLocation result = service->getLocation(long_ip);
    
    EXPECT_FALSE(result.success);
    EXPECT_FALSE(result.error_message.empty());
}

