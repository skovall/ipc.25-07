TEST_F(GeoLocationServiceTest, ClearCache_ShouldNotThrow) {
    EXPECT_NO_THROW(service->clearCache());
    
    // Заполняем кэш
    service->getLocation("8.8.8.8");
    service->getLocation("1.1.1.1");
    
    EXPECT_NO_THROW(service->clearCache());
    
    // После очистки сервис должен быть доступен
    EXPECT_TRUE(service->isAvailable());
}

TEST_F(GeoLocationServiceTest, ClearCache_AfterClearing_DataStillAccessible) {
    service->getLocation("8.8.8.8");
    service->clearCache();
    
    // Должны получить данные снова (возможно из сети/БД)
    EXPECT_NO_THROW(service->getLocation("8.8.8.8"));
}

TEST_F(GeoLocationServiceTest, IsAvailable_ReturnsBool) {
    bool available = service->isAvailable();
    EXPECT_TRUE(available == true || available == false);
    
    // Несколько вызовов должны возвращать одинаковое значение
    EXPECT_EQ(service->isAvailable(), available);
}

