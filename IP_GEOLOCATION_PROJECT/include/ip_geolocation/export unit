#include <gtest/gtest.h>
#include <gmock/gmock.h>
#include "geolocation.hpp"

using namespace ip_geolocation;

// Тесты для структуры GeoLocation

class GeoLocationTest : public ::testing::Test {
protected:
    void SetUp() override {
        location.ip = "8.8.8.8";
        location.country = "United States";
        location.country_code = "US";
        location.region = "California";
        location.city = "Mountain View";
        location.postal_code = "94043";
        location.latitude = 37.4223;
        location.longitude = -122.0841;
        location.timezone = "America/Los_Angeles";
        location.isp = "Google LLC";
        location.organization = "Google";
        location.success = true;
    }
    
    GeoLocation location;
};

TEST_F(GeoLocationTest, ToString_ReturnsFormattedString) {
    std::string result = location.toString();
    
    EXPECT_THAT(result, ::testing::ContainsRegex("8\\.8\\.8\\.8"));
    EXPECT_THAT(result, ::testing::ContainsRegex("United States"));
    EXPECT_THAT(result, ::testing::ContainsRegex("Mountain View"));
}

TEST_F(GeoLocationTest, ToString_WithError_ShowsErrorMessage) {
    location.success = false;
    location.error_message = "Invalid IP address";
    
    std::string result = location.toString();
    EXPECT_THAT(result, ::testing::ContainsRegex("Error"));
    EXPECT_THAT(result, ::testing::ContainsRegex("Invalid IP address"));
}

TEST_F(GeoLocationTest, DefaultValues_AreZeroOrEmpty) {
    GeoLocation empty;
    
    EXPECT_EQ(empty.latitude, 0.0);
    EXPECT_EQ(empty.longitude, 0.0);
    EXPECT_FALSE(empty.success);
    EXPECT_TRUE(empty.ip.empty());
    EXPECT_TRUE(empty.country.empty());
}

// Тесты для вспомогательных функций

TEST(HelpersTest, IsValidIP_ValidIPv4_ReturnsTrue) {
    EXPECT_TRUE(isValidIP("192.168.1.1"));
    EXPECT_TRUE(isValidIP("0.0.0.0"));
    EXPECT_TRUE(isValidIP("255.255.255.255"));
}

TEST(HelpersTest, IsValidIP_InvalidIPv4_ReturnsFalse) {
    EXPECT_FALSE(isValidIP(""));
    EXPECT_FALSE(isValidIP("256.1.1.1"));
    EXPECT_FALSE(isValidIP("192.168.1"));
    EXPECT_FALSE(isValidIP("192.168.1.1.1"));
    EXPECT_FALSE(isValidIP("abc.def.ghi.jkl"));
    EXPECT_FALSE(isValidIP("192.168.1.-1"));
}

TEST(HelpersTest, IsValidIP_ValidIPv6_ReturnsTrue) {
    EXPECT_TRUE(isValidIP("2001:0db8:85a3:0000:0000:8a2e:0370:7334"));
    EXPECT_TRUE(isValidIP("::1"));
    EXPECT_TRUE(isValidIP("fe80::1ff:fe23:4567:890a"));
}

TEST(HelpersTest, IsValidIP_InvalidIPv6_ReturnsFalse) {
    EXPECT_FALSE(isValidIP("2001:0db8:85a3::8a2e:0370:7334:1234:5678")); // слишком много
    EXPECT_FALSE(isValidIP("gggg::1")); // неверные символы
}

TEST(HelpersTest, GetCurrentIP_ReturnsNonEmptyString) {
    std::string currentIP = getCurrentIP();
    
    EXPECT_FALSE(currentIP.empty());
    EXPECT_TRUE(isValidIP(currentIP));
}

// Тесты для GeoLocationService

class GeoLocationServiceTest : public ::testing::Test {
protected:
    void SetUp() override {
        service = std::make_unique<GeoLocationService>();
    }
    
    void TearDown() override {
        service.reset();
    }
    
    std::unique_ptr<GeoLocationService> service;
};

TEST_F(GeoLocationServiceTest, Constructor_CreatesValidInstance) {
    EXPECT_NE(service, nullptr);
    EXPECT_TRUE(service->isAvailable());
}

TEST_F(GeoLocationServiceTest, SetApiKey_ValidKey_NoException) {
    EXPECT_NO_THROW(service->setApiKey("test_api_key_12345"));
}

TEST_F(GeoLocationServiceTest, SetDatabasePath_ValidPath_NoException) {
    EXPECT_NO_THROW(service->setDatabasePath("./geolite2_city.mmdb"));
}

TEST_F(GeoLocationServiceTest, SetDatabasePath_EmptyPath_NoException) {
    EXPECT_NO_THROW(service->setDatabasePath(""));
}

TEST_F(GeoLocationServiceTest, GetLocation_ValidIPv4_ReturnsSuccess) {
    GeoLocation result = service->getLocation("8.8.8.8");
    
    EXPECT_TRUE(result.success);
    EXPECT_FALSE(result.country.empty());
    EXPECT_FALSE(result.ip.empty());
}

TEST_F(GeoLocationServiceTest, GetLocation_ValidIPv6_ReturnsSuccess) {
    GeoLocation result = service->getLocation("2001:4860:4860::8888");
    
    EXPECT_TRUE(result.success);
    EXPECT_EQ(result.ip, "2001:4860:4860::8888");
}

TEST_F(GeoLocationServiceTest, GetLocation_InvalidIP_ReturnsError) {
    GeoLocation result = service->getLocation("invalid_ip");
    
    EXPECT_FALSE(result.success);
    EXPECT_FALSE(result.error_message.empty());
}

TEST_F(GeoLocationServiceTest, GetLocation_Localhost_ReturnsSpecialHandling) {
    GeoLocation result = service->getLocation("127.0.0.1");
    
    // localhost может иметь особую обработку
    EXPECT_TRUE(result.success || !result.error_message.empty());
}

TEST_F(GeoLocationServiceTest, GetLocation_EmptyIP_ReturnsError) {
    GeoLocation result = service->getLocation("");
    
    EXPECT_FALSE(result.success);
    EXPECT_FALSE(result.error_message.empty());
}

TEST_F(GeoLocationServiceTest, GetLocation_ShouldBeConsistent) {
    GeoLocation result1 = service->getLocation("8.8.8.8");
    GeoLocation result2 = service->getLocation("8.8.8.8");
    
    EXPECT_EQ(result1.country, result2.country);
    EXPECT_EQ(result1.city, result2.city);
    EXPECT_EQ(result1.latitude, result2.latitude);
    EXPECT_EQ(result1.longitude, result2.longitude);
}

TEST_F(GeoLocationServiceTest, ClearCache_ShouldNotThrow) {
    // Сначала получим несколько локаций для заполнения кэша
    service->getLocation("8.8.8.8");
    service->getLocation("1.1.1.1");
    
    EXPECT_NO_THROW(service->clearCache());
    
    // После очистки кэша сервис должен быть доступен
    EXPECT_TRUE(service->isAvailable());
}

TEST_F(GeoLocationServiceTest, IsAvailable_AlwaysReturnsBool) {
    // Должен возвращать bool даже если не настроен
    bool available = service->isAvailable();
    EXPECT_TRUE(available == true || available == false);
}

// Асинхронные тесты

TEST_F(GeoLocationServiceTest, GetLocationAsync_CallbackIsCalled) {
    bool callback_called = false;
    GeoLocation async_result;
    
    service->getLocationAsync("8.8.8.8", [&](const GeoLocation& result) {
        callback_called = true;
        async_result = result;
    });
    
    // Небольшая задержка для завершения асинхронной операции
    std::this_thread::sleep_for(std::chrono::milliseconds(100));
    
    EXPECT_TRUE(callback_called);
    EXPECT_TRUE(async_result.success);
}

TEST_F(GeoLocationServiceTest, GetLocationAsync_InvalidIP_CallbackWithError) {
    bool callback_called = false;
    
    service->getLocationAsync("invalid_ip", [&](const GeoLocation& result) {
        callback_called = true;
        EXPECT_FALSE(result.success);
        EXPECT_FALSE(result.error_message.empty());
    });
    
    std::this_thread::sleep_for(std::chrono::milliseconds(100));
    EXPECT_TRUE(callback_called);
}

TEST_F(GeoLocationServiceTest, GetLocationAsync_MultipleCalls_AllCallbacksExecuted) {
    std::atomic<int> callback_count{0};
    
    service->getLocationAsync("8.8.8.8", [&](const GeoLocation&) { callback_count++; });
    service->getLocationAsync("1.1.1.1", [&](const GeoLocation&) { callback_count++; });
    service->getLocationAsync("4.4.4.4", [&](const GeoLocation&) { callback_count++; });
    
    std::this_thread::sleep_for(std::chrono::milliseconds(200));
    
    EXPECT_EQ(callback_count, 3);
}

// Интеграционные тесты

TEST(IntegrationTest, GetLocation_CoordinatesAreWithinValidRange) {
    GeoLocationService service;
    GeoLocation result = service.getLocation("8.8.8.8");
    
    if (result.success) {
        EXPECT_GE(result.latitude, -90.0);
        EXPECT_LE(result.latitude, 90.0);
        EXPECT_GE(result.longitude, -180.0);
        EXPECT_LE(result.longitude, 180.0);
    }
}

TEST(IntegrationTest, DifferentIPs_ReturnDifferentLocations) {
    GeoLocationService service;
    GeoLocation google = service.getLocation("8.8.8.8");
    GeoLocation cloudflare = service.getLocation("1.1.1.1");
    
    if (google.success && cloudflare.success) {
        // Могут быть в одной стране, но обычно разные
        EXPECT_NE(google.ip, cloudflare.ip);
    }
}

// Тесты производительности (опционально)

TEST(PerformanceTest, GetLocation_IsFast) {
    GeoLocationService service;
    
    auto start = std::chrono::high_resolution_clock::now();
    GeoLocation result = service.getLocation("8.8.8.8");
    auto end = std::chrono::high_resolution_clock::now();
    
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    
    EXPECT_TRUE(result.success);
    EXPECT_LT(duration.count(), 1000); // Должно быть быстрее 1 секунды
}

// Main функция для запуска тестов

int main(int argc, char** argv) {
    ::testing::InitGoogleTest(&argc, argv);
    return RUN_ALL_TESTS();
}
